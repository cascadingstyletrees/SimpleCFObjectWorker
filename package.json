  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.7",
    "@cloudflare/workers-types": "^4.20230323.0",
    "@tailwindcss/cli": "^4.2.0",
    "@types/node": "^20.12.12",
    "autoprefixer": "^10.4.24",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "vitest": "^3.0.5",
    "wrangler": "^3.114.0"
  },
  "dependencies": {
    "hono": "^4.11.7"
  }
}
